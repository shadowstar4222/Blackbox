<UserControl x:Class="Blackbox.App.MicrophonePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinHeight="400" MinWidth="620">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ComboBox x:Name="DeviceComboBox" Height="30" DisplayMemberPath="Name" IsEnabled="False"
                      ToolTip="Microphone device" SelectionChanged="DeviceComboBox_SelectionChanged" />
            <Button x:Name="SaveRoutingButton" Grid.Column="1" Margin="8,0,0,0" IsEnabled="False"
                    Style="{StaticResource IconButtonStyle}" Content="&#xE74E;" ToolTip="Apply microphone routing" Click="SaveRoutingButton_Click" />
        </Grid>
        <TabControl x:Name="MicrophoneTabs" Grid.Row="1">
            <TabItem Header="Voice">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,14,8,8">
                        <StackPanel x:Name="NativeMicrophonePanel" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Voice preset" VerticalAlignment="Center" />
                                <ComboBox x:Name="VoicePresetComboBox" Grid.Column="1" Height="30" SelectionChanged="VoicePresetComboBox_SelectionChanged" />
                                <Button x:Name="ApplyVoiceButton" Grid.Column="2" Margin="8,0,0,0" Click="ApplyVoiceButton_Click" ToolTip="Apply voice processing and input gain">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" /><TextBlock Text="Apply" /></StackPanel>
                                </Button>
                            </Grid>
                            <CheckBox x:Name="ProcessingEnabledCheckBox" Margin="132,12,0,0" Content="Voice processing" Checked="ProcessingControl_Changed" Unchecked="ProcessingControl_Changed" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Input gain" VerticalAlignment="Center" />
                                <Slider x:Name="InputGainSlider" Grid.Column="1" Minimum="-30" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="ProcessingControl_Changed" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding Value, ElementName=InputGainSlider, StringFormat={}{0:0} dB}" />
                            </Grid>
                            <Expander x:Name="AdvancedVoiceExpander" Header="Advanced" Margin="0,12,0,0">
                    <Grid Margin="0,10,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>

                        <CheckBox x:Name="HighPassCheckBox" Content="High-pass filter" VerticalAlignment="Center"
                                  Checked="ProcessingControl_Changed" Unchecked="ProcessingControl_Changed" />
                        <Slider x:Name="HighPassCutoffSlider" Grid.Column="1" Minimum="40" Maximum="180" TickFrequency="5"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="ProcessingControl_Changed" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Text="{Binding Value, ElementName=HighPassCutoffSlider, StringFormat={}{0:0} Hz}" />

                        <CheckBox x:Name="NoiseSuppressionCheckBox" Grid.Row="1" Content="Noise suppression" VerticalAlignment="Center"
                                  Checked="ProcessingControl_Changed" Unchecked="ProcessingControl_Changed" />
                        <Slider x:Name="NoiseSuppressionSlider" Grid.Row="1" Grid.Column="1" Minimum="-60" Maximum="0" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="ProcessingControl_Changed" />
                        <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Text="{Binding Value, ElementName=NoiseSuppressionSlider, StringFormat={}{0:0} dB}" />

                        <CheckBox x:Name="ExpanderCheckBox" Grid.Row="2" Content="Expander" VerticalAlignment="Center"
                                  Checked="ProcessingControl_Changed" Unchecked="ProcessingControl_Changed" />
                        <Slider x:Name="ExpanderThresholdSlider" Grid.Row="2" Grid.Column="1" Minimum="-80" Maximum="0" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="ProcessingControl_Changed" />
                        <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Text="{Binding Value, ElementName=ExpanderThresholdSlider, StringFormat={}{0:0} dB}" />

                        <TextBlock Grid.Row="3" Text="Low-mid EQ" VerticalAlignment="Center" />
                        <Slider x:Name="LowMidEqSlider" Grid.Row="3" Grid.Column="1" Minimum="-12" Maximum="12" TickFrequency="0.5"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="ProcessingControl_Changed" />
                        <TextBlock Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Text="{Binding Value, ElementName=LowMidEqSlider, StringFormat={}{0:+0.0;-0.0;0.0} dB}" />

                        <TextBlock Grid.Row="4" Text="Presence EQ" VerticalAlignment="Center" />
                        <Slider x:Name="PresenceEqSlider" Grid.Row="4" Grid.Column="1" Minimum="-12" Maximum="12" TickFrequency="0.5"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="ProcessingControl_Changed" />
                        <TextBlock Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Text="{Binding Value, ElementName=PresenceEqSlider, StringFormat={}{0:+0.0;-0.0;0.0} dB}" />

                        <CheckBox x:Name="CompressorCheckBox" Grid.Row="5" Content="Compressor" VerticalAlignment="Center"
                                  Checked="ProcessingControl_Changed" Unchecked="ProcessingControl_Changed" />
                        <Slider x:Name="CompressorThresholdSlider" Grid.Row="5" Grid.Column="1" Minimum="-60" Maximum="0" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="ProcessingControl_Changed" />
                        <TextBlock Grid.Row="5" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Text="{Binding Value, ElementName=CompressorThresholdSlider, StringFormat={}{0:0} dB}" />

                        <CheckBox x:Name="DeEsserCheckBox" Grid.Row="6" Content="De-esser" VerticalAlignment="Center"
                                  Checked="ProcessingControl_Changed" Unchecked="ProcessingControl_Changed" />
                        <Slider x:Name="DeEsserThresholdSlider" Grid.Row="6" Grid.Column="1" Minimum="-60" Maximum="0" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="ProcessingControl_Changed" />
                        <TextBlock Grid.Row="6" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Text="{Binding Value, ElementName=DeEsserThresholdSlider, StringFormat={}{0:0} dB}" />

                        <CheckBox x:Name="LimiterCheckBox" Grid.Row="7" Content="Limiter" VerticalAlignment="Center"
                                  Checked="ProcessingControl_Changed" Unchecked="ProcessingControl_Changed" />
                        <Slider x:Name="LimiterThresholdSlider" Grid.Row="7" Grid.Column="1" Minimum="-20" Maximum="0" TickFrequency="0.5"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="ProcessingControl_Changed" />
                        <TextBlock Grid.Row="7" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Text="{Binding Value, ElementName=LimiterThresholdSlider, StringFormat={}{0:0.0} dB}" />
                    </Grid>
                </Expander>
                            <DockPanel Margin="0,16,0,0">
                                <Button x:Name="TestMicrophoneButton" Style="{StaticResource QuietButtonStyle}" IsEnabled="False" Click="TestMicrophoneButton_Click" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" /><TextBlock Text="Test input" /></StackPanel>
                                </Button>
                                <TextBlock x:Name="NativeTestResultText" Text="Not tested" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Routing">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <CheckBox x:Name="AutomaticSelectionCheckBox" Content="Follow the Windows default microphone" />
                    <TextBlock Grid.Row="1" Text="Exclude from automatic selection" Margin="0,20,0,8" FontWeight="SemiBold" />
                    <ListBox x:Name="ExcludedDevicesList" Grid.Row="2" MaxHeight="300" VerticalAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate><DataTemplate><CheckBox Margin="4,5" Content="{Binding Name}" IsChecked="{Binding IsExcluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
            <TabItem Header="Calibration">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,8">
                        <Grid x:Name="CalibrationMeasurementsPanel"  Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="38" />
                <RowDefinition Height="38" />
            </Grid.RowDefinitions>

            <TextBlock Text="Background noise" VerticalAlignment="Center" />
            <Button x:Name="BackgroundButton"
                    Grid.Column="1"
                    Style="{StaticResource IconButtonStyle}" Content="&#xE720;" ToolTip="Measure this calibration phase"
                    Height="30"
                    Margin="0,0,10,0"
                    IsEnabled="False"
                    Click="BackgroundButton_Click" />
            <TextBlock x:Name="BackgroundResultText" Grid.Column="2" VerticalAlignment="Center" Text="Not measured" />

            <TextBlock Grid.Row="1" Text="Normal voice" VerticalAlignment="Center" />
            <Button x:Name="NormalButton"
                    Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource IconButtonStyle}" Content="&#xE720;" ToolTip="Measure this calibration phase"
                    Height="30"
                    Margin="0,0,10,0"
                    IsEnabled="False"
                    Click="NormalButton_Click" />
            <TextBlock x:Name="NormalResultText" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="Not measured" />

            <TextBlock Grid.Row="2" Text="Loud voice" VerticalAlignment="Center" />
            <Button x:Name="LoudButton"
                    Grid.Row="2"
                    Grid.Column="1"
                    Style="{StaticResource IconButtonStyle}" Content="&#xE720;" ToolTip="Measure this calibration phase"
                    Height="30"
                    Margin="0,0,10,0"
                    IsEnabled="False"
                    Click="LoudButton_Click" />
            <TextBlock x:Name="LoudResultText" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Text="Not measured" />
        </Grid>
                        <Separator Margin="0,16,0,14" />
                        <Grid x:Name="CalibrationRecommendationsPanel" >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Recommended" FontWeight="SemiBold" />
            <TextBlock x:Name="RecommendationText"
                       Grid.Column="1"
                       Text="Complete all three measurements"
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="1" Text="Checks" FontWeight="SemiBold" Margin="0,10,0,0" />
            <TextBlock x:Name="WarningText"
                       Grid.Row="1"
                       Grid.Column="1"
                       Margin="0,10,0,0"
                       Text="Waiting for measurements"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="ApplyButton"
                        Content="Apply recommendations"

                        Height="30"
                        IsEnabled="False"
                        Click="ApplyButton_Click" />
                <Button x:Name="CompareButton"
                        Style="{StaticResource QuietButtonStyle}" Content="Record comparison"

                        Height="30"
                        Margin="10,0,0,0"
                        IsEnabled="False"
                        Click="CompareButton_Click" />
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="OpenBeforeButton"
                        Style="{StaticResource QuietButtonStyle}" Content="Listen before"

                        Height="30"
                        Visibility="Collapsed"
                        Click="OpenBeforeButton_Click" />
                <Button x:Name="OpenAfterButton"
                        Style="{StaticResource QuietButtonStyle}" Content="Listen after"

                        Height="30"
                        Margin="10,0,0,0"
                        Visibility="Collapsed"
                        Click="OpenAfterButton_Click" />
                <Button x:Name="StopComparisonButton" Style="{StaticResource IconButtonStyle}" Visibility="Collapsed" Margin="10,0,0,0" Content="&#xE71A;" ToolTip="Stop comparison playback" Click="StopComparisonButton_Click" />
                <MediaElement x:Name="ComparisonPlayer" Width="0" Height="0" LoadedBehavior="Manual" UnloadedBehavior="Close" MediaEnded="ComparisonPlayer_MediaEnded" MediaFailed="ComparisonPlayer_MediaFailed" />
            </StackPanel>
        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="2">
        <ProgressBar x:Name="LevelProgressBar" Height="6" Margin="0,10,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" />
        <TextBlock x:Name="StatusText" Margin="0,10,0,0" Text="Loading microphones..." TextWrapping="Wrap">
            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
