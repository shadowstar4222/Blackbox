<UserControl x:Class="Blackbox.App.PlaybackPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blackbox.App"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        Focusable="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        IsVisibleChanged="PlaybackPage_IsVisibleChanged"
        Loaded="Window_Loaded">
    <UserControl.Resources>
        <Style x:Key="TagButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Width" Value="90" />
            <Setter Property="Height" Value="31" />
            <Setter Property="Margin" Value="0,0,7,7" />
            <Setter Property="FontSize" Value="12" />
        </Style>


    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="158" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource SidebarBrush}" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="12,0" VerticalAlignment="Center">
                <TextBlock x:Name="SessionTitleText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="PlaybackStatusText" Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center">
                <TextBlock x:Name="SegmentStatusText" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                <TextBlock x:Name="LiveStatusText" Visibility="Collapsed" Foreground="{StaticResource SuccessBrush}" FontSize="11" HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <Border Background="Black">
                <vlc:VideoView x:Name="VideoView" Background="Black" />
            </Border>

            <Grid x:Name="MomentsPanel" Grid.Column="1" Background="{StaticResource SidebarBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="16,14,16,8">
                    <TextBlock Text="Moments" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="MarkerStatusText"
                               Margin="0,3,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               Text="Tag the current frame." />
                </StackPanel>

                <WrapPanel Grid.Row="1" Margin="16,4,9,6">
                    <Button Content="Highlight" Tag="Highlight" Style="{StaticResource TagButtonStyle}" Click="QuickTagButton_Click" />
                    <Button Content="Action" Tag="Action" Style="{StaticResource TagButtonStyle}" Click="QuickTagButton_Click" />
                    <Button Content="Funny" Tag="Funny" Style="{StaticResource TagButtonStyle}" Click="QuickTagButton_Click" />
                    <Button Content="Review" Tag="Review" Style="{StaticResource TagButtonStyle}" Click="QuickTagButton_Click" />
                </WrapPanel>

                <Grid Grid.Row="2" Margin="16,4,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="38" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MarkerLabelTextBox"
                             Height="31"
                             VerticalContentAlignment="Center"
                             ToolTip="Moment label"
                             KeyDown="MarkerLabelTextBox_KeyDown" />
                    <Button Grid.Column="1"
                            Width="34"
                            Height="31"
                            Margin="4,0,0,0"
                            Content="+"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Add a manual event marker"
                            Click="AddManualMarkerButton_Click" />
                </Grid>

                <ListBox x:Name="MarkerListBox"
                         Grid.Row="3"
                         Margin="8,0"
                         Background="Transparent"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderThickness="0"
                         MouseDoubleClick="MarkerListBox_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="178" Margin="6,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="4" Margin="13,10,13,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="&#xE76B;"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Previous marker"
                            Click="PreviousMarkerButton_Click" />
                    <Button Grid.Column="1"
                            Content="&#xE76C;"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Next marker"
                            Click="NextMarkerButton_Click" />
                    <Button Grid.Column="3"
                            Content="&#xE74D;"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Remove selected marker"
                            Click="DeleteMarkerButton_Click" />
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Background="{StaticResource SidebarBrush}" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="24" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <local:TimelineWaveformControl x:Name="PlaybackTimeline"
                                           Height="56"
                                           Margin="16,10,16,2"
                                           ShowSegmentBands="True"
                                           ToolTip="Seek through the recording" />

            <Grid Grid.Row="1" Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CurrentTimeText" Text="0:00.000" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock x:Name="CurrentMarkerText"
                           Grid.Column="1"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource WarningBrush}" />
                <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00.000" TextAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
            </Grid>

            <Grid Grid.Row="2" Margin="12,8,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="|&lt;" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Start of recording" Click="StartButton_Click" />
                    <Button Content="|&#x25C0;" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Previous segment" Click="PreviousSegmentButton_Click" />
                    <Button Content="&lt;|" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Previous frame" Click="PreviousFrameButton_Click" />
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Back 10 seconds" Click="BackTenButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72B;" Margin="0,0,2,0" />
                            <TextBlock Text="10" FontSize="11" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PlayPauseButton" Width="36" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Play or pause" Click="PlayPauseButton_Click">
                        <TextBlock x:Name="PlayPauseGlyph" FontFamily="Segoe MDL2 Assets" Text="&#xE768;" FontSize="17" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Forward 10 seconds" Click="ForwardTenButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="10" FontSize="11" Margin="0,0,2,0" />
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72A;" />
                        </StackPanel>
                    </Button>
                    <Button Content="|&gt;" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Next frame" Click="NextFrameButton_Click" />
                    <Button Content="&#x25B6;|" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Next segment" Click="NextSegmentButton_Click" />
                    <Button Content="&gt;|" Style="{StaticResource ToolbarButtonStyle}" ToolTip="End of recording" Click="EndButton_Click" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="AudioTrackComboBox"
                              Width="90"
                              Height="30"
                              Margin="4,0,0,0"
                              ToolTip="Playback audio track"
                              SelectionChanged="AudioTrackComboBox_SelectionChanged" />
                    <ComboBox x:Name="PlaybackRateComboBox"
                              Width="60"
                              Height="30"
                              Margin="5,0"
                              SelectionChanged="PlaybackRateComboBox_SelectionChanged" />
                    <CheckBox x:Name="LoopCheckBox"
                              Margin="3,0,5,0"
                              VerticalAlignment="Center"
                              Content="Loop"
                              Foreground="{StaticResource TextPrimaryBrush}" />
                    <Button x:Name="MuteButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Mute or unmute"
                            Click="MuteButton_Click">
                        <TextBlock x:Name="MuteGlyph" FontFamily="Segoe MDL2 Assets" Text="&#xE767;" FontSize="16" />
                    </Button>
                    <Slider x:Name="VolumeSlider"
                            Width="60"
                            Height="28"
                            Margin="2,0,4,0"
                            Minimum="0"
                            Maximum="125"
                            Value="100"
                            ToolTip="Volume"
                            ValueChanged="VolumeSlider_ValueChanged" />
                    <Button Content="&#xE740;"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Toggle fullscreen"
                            Click="FullscreenButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
