<UserControl x:Class="Blackbox.App.PlaybackPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blackbox.App"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        Focusable="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        IsVisibleChanged="PlaybackPage_IsVisibleChanged"
        Loaded="Window_Loaded">
    <UserControl.Resources>
        <Style x:Key="TagButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Width" Value="90" />
            <Setter Property="Height" Value="31" />
            <Setter Property="Margin" Value="0,0,7,7" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="SeekButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
        </Style>
        <DataTemplate x:Key="BoundarySeekIcon">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding}" FontSize="18" VerticalAlignment="Center" />
        </DataTemplate>
        <DataTemplate x:Key="FrameSeekIcon">
            <Grid Width="24" Height="24" IsHitTestVisible="False" SnapsToDevicePixels="True">
                <Border Width="22" Height="16" BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="1" CornerRadius="2" />
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding}" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" />
                <TextBlock Text="1" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SegmentSeekIcon">
            <Grid Width="24" Height="24" IsHitTestVisible="False" SnapsToDevicePixels="True">
                <Border Height="19" BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="1" CornerRadius="2">
                    <Grid>
                        <Border BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="0,2,0,2" Margin="0,2" />
                        <Border BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="1,0" Width="8" />
                    </Grid>
                </Border>
                <Border Width="13" Height="13" Background="{StaticResource ControlBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="2">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="TimedSeekIcon">
            <Grid Width="26" Height="27" IsHitTestVisible="False">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Top" />
                <TextBlock Text="10s" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="158" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource SidebarBrush}" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="12,0" VerticalAlignment="Center">
                <TextBlock x:Name="SessionTitleText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="PlaybackStatusText" Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center">
                <TextBlock x:Name="SegmentStatusText" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                <TextBlock x:Name="LiveStatusText" Visibility="Collapsed" Foreground="{StaticResource SuccessBrush}" FontSize="11" HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <Border Background="Black">
                <vlc:VideoView x:Name="VideoView" Background="Black" />
            </Border>

            <Grid x:Name="MomentsPanel" Grid.Column="1" Background="{StaticResource SidebarBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="16,14,16,8">
                    <TextBlock Text="Moments" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="MarkerStatusText"
                               Margin="0,3,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               Text="Tag the current frame." />
                </StackPanel>

                <WrapPanel Grid.Row="1" Margin="16,4,9,6">
                    <Button Content="Highlight" Tag="Highlight" Style="{StaticResource TagButtonStyle}" Click="QuickTagButton_Click" />
                    <Button Content="Action" Tag="Action" Style="{StaticResource TagButtonStyle}" Click="QuickTagButton_Click" />
                    <Button Content="Funny" Tag="Funny" Style="{StaticResource TagButtonStyle}" Click="QuickTagButton_Click" />
                    <Button Content="Review" Tag="Review" Style="{StaticResource TagButtonStyle}" Click="QuickTagButton_Click" />
                </WrapPanel>

                <Grid Grid.Row="2" Margin="16,4,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="38" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MarkerLabelTextBox"
                             Height="31"
                             VerticalContentAlignment="Center"
                             ToolTip="Moment label"
                             KeyDown="MarkerLabelTextBox_KeyDown" />
                    <Button Grid.Column="1"
                            Width="34"
                            Height="31"
                            Margin="4,0,0,0"
                            Content="+"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Add a manual event marker"
                            Click="AddManualMarkerButton_Click" />
                </Grid>

                <ListBox x:Name="MarkerListBox"
                         Grid.Row="3"
                         Margin="8,0"
                         Background="Transparent"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderThickness="0"
                         MouseDoubleClick="MarkerListBox_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="178" Margin="6,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="4" Margin="13,10,13,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="&#xE76B;"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Previous marker"
                            Click="PreviousMarkerButton_Click" />
                    <Button Grid.Column="1"
                            Content="&#xE76C;"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Next marker"
                            Click="NextMarkerButton_Click" />
                    <Button Grid.Column="3"
                            Content="&#xE74D;"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Remove selected marker"
                            Click="DeleteMarkerButton_Click" />
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Background="{StaticResource SidebarBrush}" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="24" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <local:TimelineWaveformControl x:Name="PlaybackTimeline"
                                           Height="56"
                                           Margin="16,10,16,2"
                                           ShowSegmentBands="True"
                                           ToolTip="Seek through the recording" />

            <Grid Grid.Row="1" Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CurrentTimeText" Text="0:00.000" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock x:Name="CurrentMarkerText"
                           Grid.Column="1"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource WarningBrush}" />
                <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00.000" TextAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
            </Grid>

            <Grid x:Name="PlaybackToolbar" Grid.Row="2" Margin="12,8,12,12" Background="{StaticResource SidebarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="SeekControls" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartSeekButton" Content="&#xE892;" ContentTemplate="{StaticResource BoundarySeekIcon}" Style="{StaticResource SeekButtonStyle}" ToolTip="Jump to the start of the recording" Click="StartButton_Click" />
                    <Button x:Name="PreviousSegmentSeekButton" Content="&#xE76B;" ContentTemplate="{StaticResource SegmentSeekIcon}" Style="{StaticResource SeekButtonStyle}" ToolTip="Jump to the previous segment" Click="PreviousSegmentButton_Click" />
                    <Button x:Name="PreviousFrameSeekButton" Content="&#xE76B;" ContentTemplate="{StaticResource FrameSeekIcon}" Style="{StaticResource SeekButtonStyle}" ToolTip="Step back one frame (pauses playback)" Click="PreviousFrameButton_Click" />
                    <Button x:Name="BackTenSeekButton" Content="&#xE7A7;" ContentTemplate="{StaticResource TimedSeekIcon}" Style="{StaticResource SeekButtonStyle}" Width="40" ToolTip="Skip back 10 seconds" Click="BackTenButton_Click" />
                    <Button x:Name="PlayPauseButton" Width="42" Style="{StaticResource SeekButtonStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" ToolTip="Play" Click="PlayPauseButton_Click">
                        <TextBlock x:Name="PlayPauseGlyph" FontFamily="Segoe MDL2 Assets" Text="&#xE768;" FontSize="18" />
                    </Button>
                    <Button x:Name="ForwardTenSeekButton" Content="&#xE7A6;" ContentTemplate="{StaticResource TimedSeekIcon}" Style="{StaticResource SeekButtonStyle}" Width="40" ToolTip="Skip forward 10 seconds" Click="ForwardTenButton_Click" />
                    <Button x:Name="NextFrameSeekButton" Content="&#xE76C;" ContentTemplate="{StaticResource FrameSeekIcon}" Style="{StaticResource SeekButtonStyle}" ToolTip="Step forward one frame (pauses playback)" Click="NextFrameButton_Click" />
                    <Button x:Name="NextSegmentSeekButton" Content="&#xE76C;" ContentTemplate="{StaticResource SegmentSeekIcon}" Style="{StaticResource SeekButtonStyle}" ToolTip="Jump to the next segment" Click="NextSegmentButton_Click" />
                    <Button x:Name="EndSeekButton" Content="&#xE893;" ContentTemplate="{StaticResource BoundarySeekIcon}" Style="{StaticResource SeekButtonStyle}" ToolTip="Jump to the end of the recording" Click="EndButton_Click" />
                </StackPanel>

                <StackPanel x:Name="PlaybackOptions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="AudioTrackComboBox"
                              Width="90"
                              Height="30"
                              Margin="4,0,0,0"
                              ToolTip="Playback audio track"
                              SelectionChanged="AudioTrackComboBox_SelectionChanged" />
                    <ComboBox x:Name="PlaybackRateComboBox"
                              Width="60"
                              Height="30"
                              Margin="5,0"
                              SelectionChanged="PlaybackRateComboBox_SelectionChanged" />
                    <CheckBox x:Name="LoopCheckBox"
                              Margin="3,0,5,0"
                              VerticalAlignment="Center"
                              Content="Loop"
                              Foreground="{StaticResource TextPrimaryBrush}" />
                    <Button x:Name="MuteButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Mute or unmute"
                            Click="MuteButton_Click">
                        <TextBlock x:Name="MuteGlyph" FontFamily="Segoe MDL2 Assets" Text="&#xE767;" FontSize="16" />
                    </Button>
                    <Slider x:Name="VolumeSlider"
                            Width="60"
                            Height="28"
                            Margin="2,0,4,0"
                            Minimum="0"
                            Maximum="125"
                            Value="100"
                            ToolTip="Volume"
                            ValueChanged="VolumeSlider_ValueChanged" />
                    <Button Content="&#xE740;"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Toggle fullscreen"
                            Click="FullscreenButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
