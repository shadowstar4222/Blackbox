<UserControl x:Class="Blackbox.App.DiagnosticsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinHeight="400" MinWidth="720">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ExportSupportBundleButton" Click="ExportSupportBundleButton_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" Margin="0,0,7,0" /><TextBlock Text="Support bundle" /></StackPanel>
                </Button>
                <Button x:Name="OpenLogsButton" Style="{StaticResource IconButtonStyle}" Content="&#xE8B7;" ToolTip="Open logs" Click="OpenLogsButton_Click" Margin="0,0,4,0" />
                <Button x:Name="OpenBackupsButton" Style="{StaticResource IconButtonStyle}" Content="&#xE8F1;" ToolTip="Open recovery backups" Click="OpenBackupsButton_Click" Margin="0,0,4,0" />
                <Button x:Name="RefreshButton" Style="{StaticResource IconButtonStyle}" Content="&#xE72C;" ToolTip="Refresh diagnostics" Click="RefreshButton_Click" />
            </StackPanel>
            <TextBlock Text="System snapshot" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <Grid x:Name="SystemSnapshotGrid" Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="Recording" Style="{StaticResource SecondaryTextStyle}" />
            <TextBlock x:Name="RecordingStatusText" Grid.Column="1" />
            <TextBlock Grid.Column="2" Text="Automatic capture" Style="{StaticResource SecondaryTextStyle}" />
            <TextBlock x:Name="AutomaticStatusText" Grid.Column="3" />
            <TextBlock Grid.Row="1" Text="Indexed media" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0" />
            <TextBlock x:Name="IndexedMediaText" Grid.Row="1" Grid.Column="1" Margin="0,8,14,0" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Storage" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0" />
            <TextBlock x:Name="RecordingStorageText" Grid.Row="1" Grid.Column="3" Margin="0,8,0,0" />
        </Grid>
        <TabControl x:Name="DiagnosticsTabs" Grid.Row="2" SelectionChanged="DiagnosticsTabs_SelectionChanged">
            <TabItem Header="Events">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <ComboBox x:Name="CategoryComboBox" HorizontalAlignment="Right" Width="150" Height="30" Margin="0,0,0,8" SelectionChanged="CategoryComboBox_SelectionChanged" />
                    <ListBox x:Name="LogListBox" Grid.Row="1" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid Margin="6,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="135" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Timestamp}" ToolTip="{Binding FullTimestamp}" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding CategoryAndSeverity}" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding CategoryAndSeverity}" />
                                <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
            <TabItem x:Name="SetupTab" Header="Recording setup">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,10,0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel LastChildFill="True" Margin="0,0,0,12">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="{StaticResource WarningBrush}" Margin="0,2,10,0" VerticalAlignment="Top" />
                    <TextBlock x:Name="PlaybackTestWarningText" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />
                </DockPanel>
                <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                    <StackPanel Margin="0,0,16,6">
                        <TextBlock Text="Pattern" Margin="0,0,0,4" />
                        <ComboBox x:Name="TestPatternComboBox" Width="185" Height="30" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,6">
                        <TextBlock Text="Scene" Margin="0,0,0,4" />
                        <ComboBox x:Name="TestQualityComboBox" Width="185" Height="30" />
                    </StackPanel>
                    <TextBlock Text="Runs until closed | Original stereo music" VerticalAlignment="Bottom" Margin="0,0,0,13" />
                </WrapPanel>
                <CheckBox x:Name="PlaybackTestConsentCheckBox" Grid.Row="2" Margin="0,0,0,12"
                          Checked="PlaybackTestConsent_Changed" Unchecked="PlaybackTestConsent_Changed">
                    <TextBlock Text="I understand the photosensitivity warning and want to open the setup window." TextWrapping="Wrap" />
                </CheckBox>
                <StackPanel Grid.Row="3">
                    <WrapPanel>
                        <Button x:Name="PlayTestButton" IsEnabled="False" Height="32" MinWidth="110" Margin="0,0,8,0"
                                Click="PlayTestButton_Click" ToolTip="Open a temporary recording target after confirmation">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="Open setup window" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelTestButton" Content="Cancel" Height="32" MinWidth="80"
                                Visibility="Collapsed" Click="CancelTestButton_Click" />
                    </WrapPanel>
                    <ProgressBar x:Name="TestProgressBar" IsIndeterminate="True" Height="4" Margin="0,8,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="TestStatusText" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Technical details">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,8,0">
                        <TextBlock Text="Capture checks" FontWeight="SemiBold" />
                        <TextBlock x:Name="GuardianSummaryText" Margin="0,6,0,18" TextWrapping="Wrap" />
                        <TextBlock Text="Recorder" FontWeight="SemiBold" />
                        <TextBlock x:Name="RecorderSummaryText" Margin="0,6,0,18" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="Last recovery" FontWeight="SemiBold" />
                        <TextBlock x:Name="RecoverySummaryText" Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,10,0,0" Text="Loading diagnostics..." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
    </Grid>
</UserControl>
