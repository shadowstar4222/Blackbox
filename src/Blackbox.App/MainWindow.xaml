<Window x:Class="Blackbox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Blackbox"
        Icon="Assets/Blackbox.ico"
        Height="780"
        Width="1240"
        MinHeight="680"
        MinWidth="1024"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        StateChanged="MainWindow_StateChanged">
    <Grid x:Name="ShellRoot" Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="14,10,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="28"
                           Height="28"
                           VerticalAlignment="Center"
                           Source="Assets/Blackbox.png"
                           SnapsToDevicePixels="True" />
                    <StackPanel Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock FontSize="15"
                                   FontWeight="Bold"
                                   Text="BLACKBOX" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="HomeNavButton"
                                 GroupName="Navigation"
                                 IsChecked="True"
                                 Style="{StaticResource NavigationButtonStyle}"
                                 Checked="HomeNavButton_Click"
                                 automation:AutomationProperties.Name="Capture dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="26"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Text="&#xE80F;" />
                            <TextBlock Text="Capture" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="RecordingsNavButton"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavigationButtonStyle}"
                                 Checked="RecordingNavButton_Click"
                                 automation:AutomationProperties.Name="Recordings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="26"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Text="&#xE8B2;" />
                            <TextBlock Text="Recordings" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="GamesNavButton"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavigationButtonStyle}"
                                 Checked="GamesNavButton_Click"
                                 automation:AutomationProperties.Name="Games page">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="26"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Text="&#xE7FC;" />
                            <TextBlock Text="Games" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="MicrophoneNavButton"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavigationButtonStyle}"
                                 Checked="MicrophoneNavButton_Click"
                                 automation:AutomationProperties.Name="Microphone page">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="26"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Text="&#xE720;" />
                            <TextBlock Text="Microphone" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="DiagnosticsNavButton"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavigationButtonStyle}"
                                 Checked="DiagnosticsNavButton_Click"
                                 automation:AutomationProperties.Name="Diagnostics page">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="26"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Text="&#xE9D9;" />
                            <TextBlock Text="Diagnostics" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <Separator Margin="18,0,18,10" />
                    <RadioButton x:Name="HelpNavButton"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavigationButtonStyle}"
                                 Checked="HelpNavButton_Click"
                                 automation:AutomationProperties.Name="Help and tutorial">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="26"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Text="&#xE897;" />
                            <TextBlock Text="Help" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SettingsNavButton"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavigationButtonStyle}"
                                 Checked="SettingsNavButton_Click"
                                 automation:AutomationProperties.Name="Settings page">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="26"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Text="&#xE713;" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </RadioButton>
                    <Grid Margin="22,10,18,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="SidebarStatusDot"
                                 Width="8"
                                 Height="8"
                                 Margin="0,0,9,0"
                                 Fill="{StaticResource WarningBrush}" />
                        <TextBlock x:Name="SidebarStatusText"
                                   Grid.Column="1"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   FontSize="11"
                                   Text="Starting" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="56" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Background="{StaticResource AppBackgroundBrush}">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton"
                            Width="36"
                            Height="36"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Back"
                            Visibility="Collapsed"
                            Click="BackButton_Click"
                            Content="&#xE72B;"
                            automation:AutomationProperties.Name="Back" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentViewTitleText"
                                   Style="{StaticResource PageTitleStyle}"
                                   Text="Capture" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Width="142" Height="30" Style="{StaticResource QuietButtonStyle}" Click="OpenCommandPalette_Click" ToolTip="Find a command (Ctrl+K)">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" Margin="0,0,8,0" /><TextBlock Text="Find command" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="CapturePage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="18,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="CurrentGameText" Text="No window selected" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="StatusText" Visibility="Collapsed" Margin="0,5,12,0" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Top" Click="GamesButton_Click" ToolTip="Choose an application window">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7F4;" Margin="0,0,8,0" /><TextBlock Text="Choose window" /></StackPanel>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border Height="300" Background="#090A0C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="GuardianPreviewImage" Stretch="Uniform" SnapsToDevicePixels="True" />
                                    <TextBlock x:Name="GuardianPreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets" FontSize="40" Text="&#xE714;" Opacity="0.35" ToolTip="Capture preview" />
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="GuardianVideoText" Visibility="Collapsed" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Style="{StaticResource QuietButtonStyle}" Click="RecordingLibraryButton_Click" ToolTip="Review complete recordings"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B2;" Margin="0,0,7,0" /><TextBlock Text="Review" /></StackPanel></Button>
                            </Grid>
                        </Grid>
                        <StackPanel Grid.Column="2">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="CAPTURE HEALTH" FontSize="10" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                <Button x:Name="GuardianCheckButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="&#xE72C;" Click="GuardianCheckButton_Click" ToolTip="Check capture health" />
                            </Grid>
                            <TextBlock x:Name="CaptureHealthSummaryText" Text="No capture to check" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock x:Name="GuardianMessageText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,8" />
                            <Separator Margin="0,14,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="AUDIO" FontSize="10" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                <Button x:Name="AudioButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="&#xE72C;" ToolTip="Apply audio routing" Click="AudioButton_Click" />
                            </Grid>
                            <TextBlock x:Name="AudioSignalText" Text="Levels available during capture" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <Grid x:Name="GuardianAudioMeterRow" Visibility="Collapsed" Margin="0,5,0,0">
                                <ProgressBar x:Name="GuardianAudioMeter" Height="6" Minimum="0" Maximum="60" />
                            </Grid>
                            <TextBlock x:Name="MicrophoneSignalText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                    <Expander Grid.Row="2" Header="Session details" Margin="0,14,0,0">
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="DESTINATION" FontSize="10" Style="{StaticResource SecondaryTextStyle}" />
                                <Grid Margin="0,5,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LocationText" Text="-" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    <Button x:Name="OpenRecordingsButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="&#xE8B7;" Click="OpenRecordingsButton_Click" ToolTip="Open recording folder" />
                                </Grid>
                                <TextBlock x:Name="GuardianEvidenceText" Text="No capture evidence yet." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" MaxHeight="100" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="QualitySummaryText" Text="Recording quality" FontWeight="SemiBold" />
                                <TextBlock x:Name="SegmentLengthText" Text="2 minute segments" Margin="0,5,0,8" Style="{StaticResource SecondaryTextStyle}" />
                                <WrapPanel>
                                    <Button x:Name="ObsSetupButton" Content="Check recorder" Click="ObsSetupButton_Click" Style="{StaticResource QuietButtonStyle}" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Expander>
                </Grid>
            </ScrollViewer>

            <Grid x:Name="WorkspacePageHost"
                  Grid.Row="1"
                  Background="{StaticResource AppBackgroundBrush}"
                  ClipToBounds="True"
                  Visibility="Collapsed" />

            <Border x:Name="CaptureToolbar" Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="AutoCaptureButton" Content="Enable auto" Click="AutoCaptureButton_Click" Margin="0,0,12,0" Style="{StaticResource QuietButtonStyle}" ToolTip="Watch remembered applications" />
                        <ComboBox x:Name="ClipDurationComboBox" Width="68" Height="30" IsEditable="True" SelectedIndex="1" Margin="0,0,5,0" ToolTip="Clip duration">
                            <ComboBoxItem Content="30s" /><ComboBoxItem Content="2m" /><ComboBoxItem Content="5m" />
                        </ComboBox>
                        <Button x:Name="SaveClipButton" Style="{StaticResource IconButtonStyle}" Content="&#xE714;" Click="SaveClipButton_Click" ToolTip="Save recent clip" />
                        <Button x:Name="ProtectButton" Style="{StaticResource IconButtonStyle}" Content="&#xE72E;" Click="ProtectButton_Click" ToolTip="Protect previous 5 minutes" />
                        <Button x:Name="AddMomentButton" Style="{StaticResource IconButtonStyle}" Content="&#xE735;" Click="AddMomentButton_Click" ToolTip="Mark this moment" />
                        <Separator Margin="10,6" />
                        <Button x:Name="StopButton" Width="72" Content="Stop" Style="{StaticResource DangerButtonStyle}" Click="StopButton_Click" Margin="0,0,7,0" IsEnabled="False" ToolTip="Stop recording" />
                        <Button x:Name="StartButton" Width="110" Content="Record" Style="{StaticResource PrimaryButtonStyle}" Click="StartButton_Click" IsEnabled="False" ToolTip="Start recording" />
                    </StackPanel>
                </Grid>
            </Border>
            <ProgressBar x:Name="SetupProgressBar"
                         Grid.Row="3"
                         Height="3"
                         Minimum="0"
                         Maximum="100"
                         Visibility="Collapsed" />
        </Grid>

        <Border x:Name="InlinePagePanel"
                Grid.Column="1"
                Margin="0,52,0,59"
                HorizontalAlignment="Stretch"
                Background="{StaticResource AppBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0"
                Visibility="Collapsed">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="18,16"
                          Width="720"
                          HorizontalAlignment="Left">
                        <StackPanel x:Name="HelpPageContent" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                       Text="QUICK START" />
                            <TextBlock Margin="0,8,0,18"
                                       FontSize="15"
                                       Text="Run these once, then Blackbox can stay in the notification area and record remembered games automatically."
                                       TextWrapping="Wrap" />

                            <TextBlock FontWeight="SemiBold" Text="1. Check the recorder" />
                            <TextBlock Margin="0,4,0,8"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Checks the bundled native capture engine. No account, download, or external recording app is required."
                                       TextWrapping="Wrap" />
                            <Button Margin="0,0,0,16"
                                    Click="TutorialSetupObsButton_Click"
                                    Content="Check recorder" />

                            <TextBlock FontWeight="SemiBold" Text="2. Remember a game" />
                            <TextBlock Margin="0,4,0,8"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Open the game first, refresh the taskbar-window list, select it, and choose Remember as game, then Use for capture. Manual recording requires this selection and a visible window."
                                       TextWrapping="Wrap" />
                            <Button Margin="0,0,0,16"
                                    Click="TutorialGamesButton_Click"
                                    Content="Open games" />

                            <TextBlock FontWeight="SemiBold" Text="3. Check your microphone" />
                            <TextBlock Margin="0,4,0,8"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Blackbox follows the Windows default microphone. Exclude devices you never want it to use."
                                       TextWrapping="Wrap" />
                            <Button Margin="0,0,0,16"
                                    Click="TutorialMicrophoneButton_Click"
                                    Content="Open microphone setup" />

                            <TextBlock FontWeight="SemiBold" Text="4. Enable automatic capture" />
                            <TextBlock Margin="0,4,0,8"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Enable auto on Capture. Recording starts when a remembered window appears and stops after it closes."
                                       TextWrapping="Wrap" />
                            <Button Margin="0,0,0,22"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="CompleteTutorialButton_Click"
                                    Content="Finish tutorial" />

                            <Separator Margin="0,0,0,20" />
                            <TextBlock Margin="0,0,0,14"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="BUTTON GUIDE" />

                            <TextBlock FontWeight="SemiBold" Text="Start recording / Stop" />
                            <TextBlock Margin="0,3,0,12"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Starts or ends a continuous session for the running window selected in Games. Recording will not start without a target. Segments are joined in the player and during export."
                                       TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Protect 5 min" />
                            <TextBlock Margin="0,3,0,12"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Keeps the previous five minutes from automatic storage cleanup."
                                       TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Check recorder" />
                            <TextBlock Margin="0,3,0,12"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Verifies the local recording engine. Missing runtime files are reported without downloading anything."
                                       TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Apply audio" />
                            <TextBlock Margin="0,3,0,12"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Refreshes the audio mix and the current allowed microphone. Native recordings do not yet have five isolated audio tracks."
                                       TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Enable auto / Disable auto" />
                            <TextBlock Margin="0,3,0,12"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Starts or stops watching for remembered application windows."
                                       TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Recordings" />
                            <TextBlock Margin="0,3,0,12"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Shows session review, timeline markers, tags, and continuous-video export."
                                       TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Games" />
                            <TextBlock Margin="0,3,0,12"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Lists taskbar windows and controls which remembered apps may auto-record."
                                       TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Microphone" />
                            <TextBlock Margin="0,3,0,12"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Controls microphone selection, exclusions, input gain, voice presets, and calibration."
                                       TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Diagnostics" />
                            <TextBlock Margin="0,3,0,12"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Shows system health and provides recovery and support tools."
                                       TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Settings" />
                            <TextBlock Margin="0,3,0,12"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Controls startup, background behavior, recording quality, and storage cleanup."
                                       TextWrapping="Wrap" />

                            <TextBlock Margin="0,14,0,14"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="REVIEW PLAYER" />
                            <TextBlock FontWeight="SemiBold" Text="Build preview" />
                            <TextBlock Margin="0,3,0,12"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Generates cached timeline thumbnails and a waveform without changing the recording."
                                       TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Play / Pause and -10 / +10" />
                            <TextBlock Margin="0,3,0,12"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Controls playback or jumps ten seconds backward and forward across segment boundaries."
                                       TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Frame and segment arrows" />
                            <TextBlock Margin="0,3,0,12"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Steps one frame at a time or jumps to the previous or next recorded segment."
                                       TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Loop, mute, track, speed, fullscreen" />
                            <TextBlock Margin="0,3,0,12"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Changes review playback only; the source recording and exported tracks remain intact."
                                       TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Quick tags and Add event" />
                            <TextBlock Margin="0,3,0,12"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Adds a labeled marker at the current timeline position for later navigation."
                                       TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Protect selection and Export" />
                            <TextBlock Margin="0,3,0,12"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Keeps the selected range from cleanup or exports the chosen range as one continuous file."
                                       TextWrapping="Wrap" />

                            <TextBlock Margin="0,14,0,14"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="GAME MANAGER" />
                            <TextBlock FontWeight="SemiBold" Text="Refresh applications" />
                            <TextBlock Margin="0,3,0,12"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Rebuilds the list from currently visible taskbar windows."
                                       TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Remember as game" />
                            <TextBlock Margin="0,3,0,12"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Adds the selected running window to the automatic-capture allowlist."
                                       TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Use for capture" />
                            <TextBlock Margin="0,3,0,12"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Makes the selected running remembered game the capture target. Manual recording requires a selected, open window."
                                       TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Save profile / Remove profile" />
                            <TextBlock Margin="0,3,0,12"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Saves capture preferences for the selected app or removes it from remembered games."
                                       TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Add alias / Remove alias" />
                            <TextBlock Margin="0,3,0,12"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Associates or removes another executable used by the same game or launcher."
                                       TextWrapping="Wrap" />

                            <TextBlock Margin="0,14,0,14"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="MICROPHONE SETUP" />
                            <TextBlock FontWeight="SemiBold" Text="Apply routing" />
                            <TextBlock Margin="0,3,0,12"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Saves automatic selection, exclusions, or the selected microphone for the native recorder."
                                       TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Measure" />
                            <TextBlock Margin="0,3,0,12"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Measures background noise, normal speech, and loud speech to recommend microphone levels."
                                       TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Apply recommendations / Record comparison" />
                            <TextBlock Margin="0,3,0,12"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Applies calibrated voice settings or records samples with processing off and on. Select a capture window before recording a comparison."
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel x:Name="SettingsPageContent" Visibility="Collapsed">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                            <TextBlock Text="STARTUP" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,16" Style="{StaticResource SecondaryTextStyle}" />
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="14"
                                           Text="Start with Windows" />
                                <ToggleButton x:Name="StartWithWindowsToggle"
                                              Grid.Column="1"
                                              Style="{StaticResource SwitchStyle}"
                                              Click="StartWithWindowsToggle_Click"
                                              automation:AutomationProperties.Name="Start Blackbox with Windows" />
                            </Grid>
                            <Separator Margin="0,0,0,20" />
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="14"
                                           Text="Automatic recording at startup" />
                                <ToggleButton x:Name="WatchGamesToggle"
                                              Grid.Column="1"
                                              Style="{StaticResource SwitchStyle}"
                                              Click="WatchGamesToggle_Click"
                                              automation:AutomationProperties.Name="Enable automatic recording at startup" />
                            </Grid>
                            <Separator Margin="0,0,0,20" />
                            <Grid Margin="0,0,0,26">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="14"
                                           Text="Close to notification area" />
                                <ToggleButton x:Name="CloseToTrayToggle"
                                              Grid.Column="1"
                                              Style="{StaticResource SwitchStyle}"
                                              Click="CloseToTrayToggle_Click"
                                              automation:AutomationProperties.Name="Keep Blackbox running in notification area" />
                            </Grid>
                            <Separator Margin="0,0,0,20" />
                            </StackPanel><StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,14"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="RECORDING QUALITY" />
                            <TextBlock Margin="0,0,0,6"
                                       FontSize="13"
                                       Text="Resolution" />
                            <ComboBox x:Name="ResolutionComboBox"
                                      Margin="0,0,0,14"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      automation:AutomationProperties.Name="Recording resolution" />
                            <TextBlock Margin="0,0,0,6"
                                       FontSize="13"
                                       Text="Frame rate" />
                            <ComboBox x:Name="FrameRateComboBox"
                                      Margin="0,0,0,14"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      automation:AutomationProperties.Name="Recording frame rate" />
                            <TextBlock Margin="0,0,0,6"
                                       FontSize="13"
                                       Text="Audio quality" />
                            <ComboBox x:Name="AudioQualityComboBox"
                                      Margin="0,0,0,14"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      automation:AutomationProperties.Name="Recording audio quality" />
                            <Button x:Name="ApplyQualityButton"
                                    Margin="0,0,0,20"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="ApplyQualityButton_Click"
                                    Content="Apply recording quality" />
                            <Button x:Name="PruneButton"
                                    Margin="0,0,0,8"
                                    Click="PruneButton_Click"
                                    Content="Apply storage quotas" />
                            <Button Click="OpenRecordingsButton_Click"
                                    Content="Open recording folder" />
                            </StackPanel></Grid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid x:Name="CommandPaletteOverlay" Grid.ColumnSpan="2" Panel.ZIndex="100" Background="#B0000000" Visibility="Collapsed" MouseLeftButtonDown="CommandPaletteOverlay_MouseLeftButtonDown"
              FocusManager.IsFocusScope="True" FocusManager.FocusedElement="{Binding ElementName=CommandSearchBox}" KeyboardNavigation.TabNavigation="Cycle">
            <Border Width="500" MaxHeight="520" Margin="16,68,16,16" VerticalAlignment="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Quick actions" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="&#xE711;" ToolTip="Close quick actions" Click="CloseCommandPalette_Click" />
                    </Grid>
                    <TextBox x:Name="CommandSearchBox" Grid.Row="1" Height="34" Style="{StaticResource SearchTextBoxStyle}" Tag="Search commands" TextChanged="CommandSearchBox_TextChanged" PreviewKeyDown="CommandPalette_PreviewKeyDown" automation:AutomationProperties.Name="Search commands" />
                    <TextBlock x:Name="CommandNoResultsText" Grid.Row="2" Text="No matching actions" Margin="8,20,8,10" Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed" />
                    <ListBox x:Name="CommandResultsList" Grid.Row="2" Margin="0,10,0,0" MaxHeight="380" BorderThickness="0" HorizontalContentAlignment="Stretch" PreviewKeyDown="CommandPalette_PreviewKeyDown" MouseLeftButtonUp="CommandResultsList_MouseLeftButtonUp">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid Margin="8,7"><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                                <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,3,0,0" Foreground="{StaticResource TextSecondaryBrush}" /></StackPanel>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
