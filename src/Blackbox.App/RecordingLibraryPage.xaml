<UserControl x:Class="Blackbox.App.RecordingLibraryPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blackbox.App"
        MinHeight="440"
        MinWidth="760">
    <Grid>
    <Grid x:Name="LibrarySurface" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="StatusText"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           Text="Loading recording sessions..."
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="OpenFolderButton"
                        Content="&#xE8B7;"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Open recording folder"
                        Margin="0,0,8,0"
                        Click="OpenFolderButton_Click" />
                <Button x:Name="RefreshButton"
                        Content="&#xE72C;"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Refresh recordings"
                        Click="RefreshButton_Click" />
                <Button x:Name="LiveReviewButton" Style="{StaticResource QuietButtonStyle}" Margin="8,0,0,0" ToolTip="Review finalized segments while recording continues" Click="LiveReviewButton_Click" Content="Time-shift" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,10,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
            <TextBox x:Name="SessionSearchBox" Height="30" Margin="0,0,8,0" Style="{StaticResource SearchTextBoxStyle}" Tag="Search application, date, or marker" TextChanged="SessionFilters_Changed" ToolTip="Search application, date, or marker" />
            <ComboBox x:Name="SessionFilterComboBox" Grid.Column="1" Height="30" Margin="0,0,8,0" SelectedIndex="0" SelectionChanged="SessionFilters_Changed" ToolTip="Filter recordings">
                <ComboBoxItem Content="All recordings" /><ComboBoxItem Content="Today" /><ComboBoxItem Content="Protected" /><ComboBoxItem Content="Needs attention" />
            </ComboBox>
            <ComboBox x:Name="SessionSortComboBox" Grid.Column="2" Height="30" SelectedIndex="0" SelectionChanged="SessionFilters_Changed" ToolTip="Sort recordings">
                <ComboBoxItem Content="Newest first" /><ComboBoxItem Content="Oldest first" /><ComboBoxItem Content="Longest first" />
            </ComboBox>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="SessionListBox"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="1"
                     SelectionChanged="SessionListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1"
                                       Margin="0,4,0,0"
                                       Text="{Binding RecordedAt}"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            <TextBlock Grid.Row="2"
                                       Margin="0,3,0,0"
                                       Text="{Binding Summary}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="SessionTitleText"
                                   Text="Select a recording"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="SessionSummaryText"
                                   Margin="0,4,0,0"
                                   Text="-"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock x:Name="HealthText"
                               Grid.Column="1"
                               Margin="20,0,0,0"
                               FontWeight="SemiBold"
                               Text="-"
                               VerticalAlignment="Center" />
                </Grid>

                <TabControl x:Name="RecordingTabs" Grid.Row="1" Margin="0,14,0,0">
                    <TabItem x:Name="TimelineTab" Header="Timeline">
                        <Grid x:Name="TimelineLayout">
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Visibility, ElementName=TimelineDetailsPanel}" Value="Collapsed">
                                        <Setter Property="VerticalAlignment" Value="Stretch" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel x:Name="LibraryEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="Assets/Blackbox.png" Width="40" Height="40" Margin="0,0,0,12" Opacity="0.6" />
                            <TextBlock Text="No recording selected" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <ScrollViewer x:Name="TimelineDetailsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="TimelineDetailsContent" Margin="10" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="136" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="64" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Image x:Name="PreviewImage"
                                           Width="238"
                                           Height="134"
                                           Stretch="Uniform"
                                           SnapsToDevicePixels="True" />
                                </Border>
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="CursorTimeText" Text="0:00" FontSize="20" FontWeight="SemiBold" />
                                    <StackPanel Grid.Row="1" Margin="0,6,0,0">
                                        <TextBlock x:Name="PreviewStatusText"
                                                   Text="Timeline preview pending"
                                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                                   TextWrapping="Wrap" />
                                        <Button x:Name="BuildPreviewButton"
                                                Content="Build preview"
                                                MinWidth="104"
                                                Height="28"
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Left"
                                                Visibility="Collapsed"
                                                Click="BuildPreviewButton_Click" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Margin="0,8,0,0" Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Rectangle Width="18" Height="10" Fill="#733A8B5A" Margin="0,0,8,0" />
                                            <TextBlock Text="Protected" FontSize="10" Margin="0,0,8,0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Rectangle Width="18" Height="10" Fill="#96B64D4D" Margin="0,0,8,0" />
                                            <TextBlock Text="Damaged" FontSize="10" Margin="0,0,8,0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="2" Height="12" Fill="#F4C95D" Margin="8,0,16,0" />
                                            <TextBlock Text="Marker" FontSize="10" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="HealthDetailText"
                                               Grid.Row="3"
                                               Margin="0,16,0,0"
                                               Text="-"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                </Grid>
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          Height="96"
                                          Margin="0,10,0,0"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=ThumbnailItemsControl}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
                                <ItemsControl x:Name="ThumbnailItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="162" Margin="0,0,6,0">
                                                <Border Width="160" Height="90" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                    <Image Source="{Binding Image}" Stretch="Uniform" />
                                                </Border>
                                                <TextBlock Text="{Binding Time}" Margin="0,3,0,0" FontSize="11" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <local:TimelineWaveformControl x:Name="WaveformTimeline"
                                                           Grid.Row="2"
                                                           Height="54"
                                                           Margin="0,10,0,0"
                                                           ToolTip="Scrub timeline" />

                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cursor" VerticalAlignment="Center" />
                                <Slider x:Name="PlayheadSlider"
                                        Grid.Column="1"
                                        Margin="0,0,12,0"
                                        Minimum="0"
                                        IsEnabled="False"
                                        ValueChanged="PlayheadSlider_ValueChanged" />
                                <TextBlock x:Name="PlayheadTimeText" Grid.Column="2" Text="0:00" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Grid.Row="4" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Start" VerticalAlignment="Center" />
                                <Slider x:Name="SelectionStartSlider"
                                        Grid.Column="1"
                                        Margin="0,0,12,0"
                                        Minimum="0"
                                        IsEnabled="False"
                                        ValueChanged="SelectionStartSlider_ValueChanged" />
                                <TextBlock x:Name="SelectionStartText" Grid.Column="2" Text="0:00" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="End" Margin="0,8,0,0" VerticalAlignment="Center" />
                                <Slider x:Name="SelectionEndSlider"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,8,12,0"
                                        Minimum="0"
                                        IsEnabled="False"
                                        ValueChanged="SelectionEndSlider_ValueChanged" />
                                <TextBlock x:Name="SelectionEndText"
                                           Grid.Row="1"
                                           Grid.Column="2"
                                           Margin="0,8,0,0"
                                           Text="0:00"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Grid Grid.Row="5" Margin="0,14,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="1"
                                            Margin="0,10,0,0"
                                            Orientation="Horizontal">
                                    <TextBlock Text="Marker context"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Before"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center" />
                                    <ComboBox x:Name="MarkerContextBeforeComboBox"
                                              Width="72"
                                              Height="28"
                                              SelectedIndex="1">
                                        <ComboBoxItem Content="15s" />
                                        <ComboBoxItem Content="30s" />
                                        <ComboBoxItem Content="1m" />
                                        <ComboBoxItem Content="2m" />
                                    </ComboBox>
                                    <TextBlock Text="After"
                                               Margin="12,0,6,0"
                                               VerticalAlignment="Center" />
                                    <ComboBox x:Name="MarkerContextAfterComboBox"
                                              Width="72"
                                              Height="28"
                                              SelectedIndex="1">
                                        <ComboBoxItem Content="5s" />
                                        <ComboBoxItem Content="10s" />
                                        <ComboBoxItem Content="30s" />
                                        <ComboBoxItem Content="1m" />
                                    </ComboBox>
                                </StackPanel>
                                <ListBox x:Name="MarkerListBox"
                                         Grid.Row="2"
                                         Margin="0,10,0,0"
                                         MaxHeight="180"
                                         VerticalAlignment="Top"
                                         HorizontalContentAlignment="Stretch"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VirtualizingPanel.ScrollUnit="Pixel"
                                         SelectionChanged="MarkerListBox_SelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.Style>
                                        <Style TargetType="{x:Type ListBox}" BasedOn="{StaticResource {x:Type ListBox}}">
                                            <Style.Triggers>
                                                <Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Time}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Context}"
                                                           Margin="0,0,10,0"
                                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                                <Button Grid.Column="3"
                                                        Content="Remove"
                                                        MinWidth="70"
                                                        Height="24"
                                                        CommandParameter="{Binding Id}"
                                                        Click="DeleteMarkerButton_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                        </ScrollViewer>
                                <WrapPanel x:Name="TimelineActions" Grid.Row="1" Orientation="Horizontal" Margin="10,8,10,10" Visibility="{Binding Visibility, ElementName=TimelineDetailsPanel}">
                                    <Button x:Name="PlayButton"
                                            Content="Play from cursor"
                                            MinWidth="130"
                                            Height="32"
                                            IsEnabled="False"
                                            Click="PlayButton_Click" />
                                    <Button x:Name="FullSessionButton"
                                            Content="Use full"
                                            MinWidth="90"
                                            Height="32"
                                            Margin="8,0,0,0"
                                            IsEnabled="False"
                                            Click="FullSessionButton_Click" />
                                    <Button x:Name="AddMarkerButton"
                                            Content="Add marker"
                                            MinWidth="100"
                                            Height="32"
                                            Margin="8,0,0,0"
                                            IsEnabled="False"
                                            Click="AddMarkerButton_Click" />
                                    <Button x:Name="ProtectSelectionButton"
                                            Content="Protect selection"
                                            MinWidth="130"
                                            Height="32"
                                            Margin="8,0,0,0"
                                            IsEnabled="False"
                                            Click="ProtectSelectionButton_Click" />
                                </WrapPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Notes">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Attach to"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <ComboBox x:Name="NoteTargetComboBox"
                                          Grid.Column="1"
                                          Height="30"
                                          SelectionChanged="NoteTargetComboBox_SelectionChanged" />
                                <TextBlock Grid.Column="2"
                                           Margin="18,0,0,0"
                                           Text="Marker"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <ComboBox x:Name="NoteMarkerComboBox"
                                          Grid.Column="3"
                                          Height="30"
                                          DisplayMemberPath="Label"
                                          SelectionChanged="NoteMarkerComboBox_SelectionChanged" />
                            </Grid>

                            <ListBox x:Name="NoteListBox"
                                     Grid.Row="1"
                                     Margin="0,12,0,12"
                                     HorizontalContentAlignment="Stretch"
                                     SelectionChanged="NoteListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Text}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Text="{Binding Detail}"
                                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding UpdatedAt}"
                                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBox x:Name="NoteTextBox"
                                     Grid.Row="2"
                                     MinHeight="82"
                                     MaxLength="4000"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />

                            <WrapPanel Grid.Row="3"
                                       ItemHeight="40"
                                       Orientation="Horizontal"
                                       Margin="0,12,0,0">
                                <Button x:Name="SaveNoteButton"
                                        Content="Save note"
                                        MinWidth="96"
                                        Height="32"
                                        Click="SaveNoteButton_Click" />
                                <Button x:Name="NewNoteButton"
                                        Content="New note"
                                        MinWidth="92"
                                        Height="32"
                                        Margin="8,0,0,0"
                                        Click="NewNoteButton_Click" />
                                <Button x:Name="DeleteNoteButton"
                                        Content="Delete note"
                                        MinWidth="100"
                                        Height="32"
                                        Margin="8,0,0,0"
                                        IsEnabled="False"
                                        Click="DeleteNoteButton_Click" />
                            </WrapPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Audio &amp; export">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Preset" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <ComboBox x:Name="ExportPresetComboBox"
                                          Grid.Column="1"
                                          Height="30"
                                          SelectionChanged="ExportPresetComboBox_SelectionChanged" />
                                <TextBlock x:Name="ExportRangeText"
                                           Grid.Column="2"
                                           Margin="18,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="Selection 0:00 - 0:00"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,18,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Track" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Mute" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Solo" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="Volume" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="5" Text="WAV" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </Grid>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="AudioTrackItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="48">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="64" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                <CheckBox Grid.Column="1"
                                                          IsChecked="{Binding IsMuted}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Checked="AudioTrackControl_Changed"
                                                          Unchecked="AudioTrackControl_Changed" />
                                                <CheckBox Grid.Column="2"
                                                          IsChecked="{Binding IsSolo}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Checked="AudioTrackControl_Changed"
                                                          Unchecked="AudioTrackControl_Changed" />
                                                <Slider Grid.Column="3"
                                                        Minimum="0"
                                                        Maximum="2"
                                                        Value="{Binding Volume}"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Center"
                                                        ValueChanged="AudioVolumeSlider_ValueChanged" />
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding VolumeText}"
                                                           VerticalAlignment="Center" />
                                                <CheckBox Grid.Column="5"
                                                          IsChecked="{Binding ExportAsWav}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Checked="AudioTrackControl_Changed"
                                                          Unchecked="AudioTrackControl_Changed" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,18,0,0">
                                <Button x:Name="ExportButton"
                                        Content="Export selection"
                                        MinWidth="140"
                                        Height="34"
                                        IsEnabled="False"
                                        Click="ExportButton_Click" />
                                <Button x:Name="CancelExportButton"
                                        Content="Cancel"
                                        MinWidth="85"
                                        Height="34"
                                        Margin="10,0,0,0"
                                        Visibility="Collapsed"
                                        Click="CancelExportButton_Click" />
                                <Button x:Name="OpenExportButton"
                                        Content="Open export"
                                        MinWidth="110"
                                        Height="34"
                                        Margin="10,0,0,0"
                                        Visibility="Collapsed"
                                        Click="OpenExportButton_Click" />
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Clip inbox">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Instant clips"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="ClipInboxSummaryText"
                                               Margin="0,4,0,0"
                                               Text="No clips"
                                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                </StackPanel>
                                <Button x:Name="RefreshClipsButton"
                                        Grid.Column="1"
                                        Content="Refresh"
                                        MinWidth="86"
                                        Height="30"
                                        Click="RefreshClipsButton_Click" />
                            </Grid>

                            <ListBox x:Name="ClipListBox"
                                     Grid.Row="1"
                                     Margin="0,12,0,12"
                                     HorizontalContentAlignment="Stretch"
                                     SelectionChanged="ClipListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Label}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,3,0,0"
                                                           Text="{Binding Detail}"
                                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,3,0,0"
                                                           Text="{Binding Failure}"
                                                           Foreground="{StaticResource RecordingBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Status}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ClipNoteTextBox"
                                         MinHeight="52"
                                         MaxLength="4000"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         IsEnabled="False" />
                                <Button x:Name="SaveClipNoteButton"
                                        Grid.Column="1"
                                        Content="Save note"
                                        MinWidth="90"
                                        Height="32"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Top"
                                        IsEnabled="False"
                                        Click="SaveClipNoteButton_Click" />
                                <Button x:Name="DeleteClipNoteButton"
                                        Grid.Column="2"
                                        Content="Delete note"
                                        MinWidth="92"
                                        Height="32"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Top"
                                        IsEnabled="False"
                                        Click="DeleteClipNoteButton_Click" />
                            </Grid>

                            <StackPanel Grid.Row="3"
                                        Orientation="Horizontal"
                                        Margin="0,12,0,0">
                                <Button x:Name="OpenClipButton"
                                        Content="Open clip"
                                        MinWidth="92"
                                        Height="32"
                                        IsEnabled="False"
                                        Click="OpenClipButton_Click" />
                                <Button x:Name="OpenClipSourceButton"
                                        Content="Open source"
                                        MinWidth="100"
                                        Height="32"
                                        Margin="8,0,0,0"
                                        IsEnabled="False"
                                        Click="OpenClipSourceButton_Click" />
                                <Button x:Name="ProtectClipButton"
                                        Content="Protect"
                                        MinWidth="88"
                                        Height="32"
                                        Margin="8,0,0,0"
                                        IsEnabled="False"
                                        Click="ProtectClipButton_Click" />
                                <Button x:Name="RetryClipButton"
                                        Content="Retry"
                                        MinWidth="80"
                                        Height="32"
                                        Margin="8,0,0,0"
                                        IsEnabled="False"
                                        Click="RetryClipButton_Click" />
                                <Button x:Name="ExportedClipButton"
                                        Content="Mark exported"
                                        MinWidth="110"
                                        Height="32"
                                        Margin="8,0,0,0"
                                        IsEnabled="False"
                                        Click="ExportedClipButton_Click" />
                                <Button x:Name="DiscardClipButton"
                                        Content="Discard"
                                        MinWidth="82"
                                        Height="32"
                                        Margin="8,0,0,0"
                                        IsEnabled="False"
                                        Click="DiscardClipButton_Click" />
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <ProgressBar x:Name="OperationProgressBar"
                     Grid.Row="3"
                     Height="7"
                     Minimum="0"
                     Maximum="100"
                     Visibility="Collapsed" />
    </Grid>
    <ContentControl x:Name="PlaybackHost" Visibility="Collapsed" />
    </Grid>
</UserControl>
