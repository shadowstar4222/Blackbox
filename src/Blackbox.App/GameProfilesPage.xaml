<UserControl x:Class="Blackbox.App.GameProfilesPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinHeight="440"
        MinWidth="760">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="ActiveCaptureText"
                           Text="Active capture: Automatic selection"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" />
            </StackPanel>
            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    Style="{StaticResource IconButtonStyle}" Content="&#xE72C;" ToolTip="Refresh running windows"
                    Click="RefreshButton_Click" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Open application windows" FontSize="16" FontWeight="SemiBold" />
                <ListBox x:Name="RunningApplicationsList"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Grid.Row="1"
                         Margin="0,10,0,10"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="1"
                                           Margin="0,3,0,0"
                                           Text="{Binding ExecutableName}"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                <TextBlock Grid.Row="2"
                                           Margin="0,3,0,0"
                                           Text="{Binding ActivitySummary}"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                <TextBlock Grid.Row="3"
                                           Margin="0,3,0,0"
                                           Text="{Binding CaptureSummary}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RememberButton"
                            Content="Remember"
                            ToolTip="Remember this application for automatic recording"
                            Height="34"
                            Margin="0,0,5,0"
                            IsEnabled="False"
                            Click="RememberButton_Click" />
                    <Button x:Name="AddAliasButton"
                            Grid.Column="1"
                            Content="Add alias"
                            Height="34"
                            Margin="5,0,0,0"
                            IsEnabled="False"
                            ToolTip="Associate this running executable with the selected remembered game"
                            Click="AddAliasButton_Click" />
                    <Button x:Name="UseForCaptureButton"
                            Grid.Column="2"
                            Content="Capture"
                            Height="34"
                            Margin="5,0,0,0"
                            IsEnabled="False"
                            ToolTip="Switch video and game audio to this remembered application"
                            Click="UseForCaptureButton_Click" />
                </Grid>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="0.9*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1.1*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Remembered games" FontSize="16" FontWeight="SemiBold" />
                <ListBox x:Name="RememberedGamesList"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Grid.Row="1"
                         Margin="0,10,0,10"
                         MinHeight="155"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="{Binding ExecutablePath}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ExecutablePath}"
                                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="{Binding PreferenceSummary}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource IconButtonStyle}" Content="&#xE74D;" ToolTip="Remove remembered game"
                                        VerticalAlignment="Center"
                                        Click="RemoveGameButton_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Separator Grid.Row="2" Margin="0,2,0,12" />

                <ScrollViewer x:Name="ProfileSettingsScrollViewer" Grid.Row="3"
                              CanContentScroll="False"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SelectedProfilePanel" IsEnabled="False">
                        <TextBlock x:Name="SelectedGameText"
                                   Text="Selected game settings"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="EffectiveProfileText"
                                   Margin="0,5,0,0"
                                   Text="Select a remembered game."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource AccentBrush}" />

                        <UniformGrid Rows="2" Columns="2" Margin="0,10,0,10">
                            <CheckBox x:Name="AutomaticRecordingCheckBox"
                                      Content="Record automatically"
                                      Margin="0,0,10,7"
                                      Click="ProfilePreferenceCheckBox_Click" />
                            <CheckBox x:Name="CaptureGameAudioCheckBox"
                                      Content="Capture game audio"
                                      Margin="0,0,0,7"
                                      Click="ProfilePreferenceCheckBox_Click" />
                            <CheckBox x:Name="FollowLauncherHandoffCheckBox"
                                      Content="Follow launcher handoffs"
                                      Margin="0,0,10,0"
                                      Click="ProfilePreferenceCheckBox_Click" />
                            <CheckBox x:Name="PreferGpuActivityCheckBox"
                                      Content="Prefer GPU-active window"
                                      Click="ProfilePreferenceCheckBox_Click" />
                        </UniformGrid>

                        <TextBlock Text="Executable aliases" FontWeight="SemiBold" />
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="AliasesList"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     MinHeight="58"
                                     MaxHeight="88"
                                     Background="{StaticResource PanelBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     ItemsSource="{Binding}" />
                            <Button x:Name="RemoveAliasButton"
                                    Grid.Column="1"
                                    Style="{StaticResource IconButtonStyle}" Content="&#xE74D;" ToolTip="Remove executable alias"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Top"
                                    IsEnabled="False"
                                    Click="RemoveAliasButton_Click" />
                        </Grid>

                        <Separator Margin="0,14,0,12" />
                        <TextBlock Text="Recording profile" FontWeight="SemiBold" />
                        <TextBlock x:Name="NativeCapabilityText" Visibility="Collapsed" Margin="0,8,0,0"
                                   Text="Native capture supports per-game microphone processing. Separate voice-chat control, cropping, and analyzed auto markers are unavailable. Existing preferences are preserved."
                                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Resolution" VerticalAlignment="Center" />
                            <ComboBox x:Name="ResolutionOverrideComboBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="1" Text="Frame rate" VerticalAlignment="Center" />
                            <ComboBox x:Name="FrameRateOverrideComboBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="2" Text="Audio quality" VerticalAlignment="Center" />
                            <ComboBox x:Name="AudioBitrateOverrideComboBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="3" Text="Encoder" VerticalAlignment="Center" Visibility="Collapsed" />
                            <ComboBox x:Name="EncoderOverrideComboBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" Visibility="Collapsed" />
                            <TextBlock Grid.Row="4" Text="Quality preset" VerticalAlignment="Center" Visibility="Collapsed" />
                            <ComboBox x:Name="QualityPresetOverrideComboBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,6" Visibility="Collapsed" />
                            <TextBlock Grid.Row="5" Text="Segment length" VerticalAlignment="Center" />
                            <ComboBox x:Name="SegmentDurationOverrideComboBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="6" Text="Storage limit" VerticalAlignment="Center" />
                            <ComboBox x:Name="StorageLimitOverrideComboBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="7" Text="Retention" VerticalAlignment="Center" />
                            <ComboBox x:Name="RetentionOverrideComboBox" Grid.Row="7" Grid.Column="1" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="8" Text="Capture delay" VerticalAlignment="Center" />
                            <ComboBox x:Name="CaptureDelayOverrideComboBox" Grid.Row="8" Grid.Column="1" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="9" Text="Microphone" VerticalAlignment="Center" />
                            <ComboBox x:Name="MicrophoneProcessingOverrideComboBox" Grid.Row="9" Grid.Column="1" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="10" Text="Crop" VerticalAlignment="Center" />
                            <ComboBox x:Name="CropOverrideComboBox" Grid.Row="10" Grid.Column="1" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="11" Text="Export" VerticalAlignment="Center" Visibility="Collapsed" />
                            <ComboBox x:Name="ExportOverrideComboBox" Grid.Row="11" Grid.Column="1" Margin="0,0,0,6" Visibility="Collapsed" />
                            <TextBlock Grid.Row="12" Text="Notifications" VerticalAlignment="Center" Visibility="Collapsed" />
                            <ComboBox x:Name="NotificationsOverrideComboBox" Grid.Row="12" Grid.Column="1" Visibility="Collapsed" />
                            <TextBlock Grid.Row="13" Text="Auto markers" VerticalAlignment="Center" />
                            <ComboBox x:Name="AutomaticMarkersOverrideComboBox"
                                      Grid.Row="13"
                                      Grid.Column="1"
                                      ToolTip="Choose when Blackbox should tag likely highlights for this game" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Microphone recording"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="CaptureMicrophoneOverrideComboBox"
                                      Grid.Column="1"
                                      ToolTip="Choose explicitly whether this game records your microphone" />
                        </Grid>
                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <CheckBox x:Name="CaptureVoiceChatOverrideCheckBox"
                                      Content="Include voice chat"
                                      IsThreeState="True" />
                        </UniformGrid>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,12,0,2">
                            <Button x:Name="ResetProfileButton"
                                    Content="Reset to global"
                                    MinWidth="110"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    Click="ResetProfileButton_Click" />
                            <Button x:Name="SaveProfileButton"
                                    Content="Apply profile"
                                    MinWidth="105"
                                    Height="32"
                                    Click="SaveProfileButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Text="Loading..."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
    </Grid>
</UserControl>
